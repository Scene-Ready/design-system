{
  "name": "@scene-ready/design-system",
  "version": "0.9.0",
  "description": "Scene Ready design system \u2014 canonical CSS tokens, Tailwind theme, self-hosted fonts, brand assets, themed email wrappers, and usage spec for Fire/EMS/SAR software.",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scene-ready/design-system.git"
  },
  "homepage": "https://github.com/scene-ready/design-system#readme",
  "bugs": {
    "url": "https://github.com/scene-ready/design-system/issues"
  },
  "type": "module",
  "exports": {
    ".": "./emails/index.js",
    "./emails": "./emails/index.js",
    "./tokens.css": "./tokens.css",
    "./tailwind.css": "./tailwind.css",
    "./fonts.css": "./fonts/fonts.css",
    "./fonts/*": "./fonts/*",
    "./assets/*": "./assets/*",
    "./BRANDING.md": "./BRANDING.md",
    "./package.json": "./package.json"
  },
  "bin": {
    "scene-ready-brand-assets": "./bin/scene-ready-brand-assets.js"
  },
  "files": [
    "tokens.css",
    "tailwind.css",
    "assets",
    "fonts",
    "bin",
    "BRANDING.md",
    "emails"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build:emails": "node scripts/build-emails.mjs",
    "preview:emails": "node scripts/preview-emails.js",
    "vendor-fonts": "node scripts/vendor-fonts.mjs",
    "sync-dark": "node scripts/sync-dark.mjs",
    "test": "vitest run",
    "check": "node scripts/sync-dark.mjs --check && node scripts/check-tailwind.mjs && node scripts/check-contrast.mjs && node scripts/build-emails.mjs --check && vitest run"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "css-variables",
    "tailwindcss",
    "email-templates",
    "mjml",
    "scene-ready"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.14.9",
    "mjml": "^4.18.0",
    "parse5": "^8.1.1",
    "vitest": "^4.1.12"
  }
}
